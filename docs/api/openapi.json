{
  "openapi": "3.0.3",
  "info": {
    "title": "Linrad DVB Receiver API",
    "version": "1.0",
    "description": "Use GET to read receiver data. To send commands, enable Allow remote receiver control under Output → Status endpoint. Send PUT requests with an empty body. Headless mode provides read-only access."
  },
  "paths": {
    "/docs": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Browse the API reference",
        "description": "Open the API documentation in a browser.",
        "responses": {
          "200": {
            "description": "HTML API reference.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Download the OpenAPI specification",
        "description": "Open this file in Swagger UI or import it into an API client.",
        "responses": {
          "200": {
            "description": "OpenAPI specification.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Read receiver status and presets",
        "description": "Read the current settings, preset slots and measurements. Check control_enabled to see whether the receiver accepts commands. Check telemetry_fresh before using the measurements to assess reception.",
        "responses": {
          "200": {
            "description": "Receiver status, including mode-specific fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/constellation": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Read constellation points",
        "description": "Read the latest I/Q points for the primary DVB-T channel. Check supported and fresh before using the points.",
        "responses": {
          "200": {
            "description": "Constellation measurement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Constellation"
                }
              }
            }
          }
        }
      }
    },
    "/control/start": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Start the SDR",
        "description": "Start reception with the current settings. Use GET /status to follow startup.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    },
    "/control/stop": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Stop the SDR",
        "description": "Stop reception. HTTP 202 means shutdown is still in progress.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "202": {
            "$ref": "#/components/responses/202"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    },
    "/control/frequency/{value}": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Tune the receiver",
        "description": "Set the RF frequency in whole Hz (e.g. /control/frequency/174928000). In DAB mode you can also select a Band III channel by name (e.g. /control/frequency/5A), including when switching back from free tuning. Inputs that support live tuning in the receiver window can also be tuned during reception through the API.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "name": "value",
            "description": "RF frequency in whole Hz within the input tuning range, or a DAB channel name such as 5A or 13F (case-insensitive).",
            "required": true,
            "example": "5A",
            "schema": {
              "oneOf": [
                { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                { "type": "string", "pattern": "^([5-9]|1[0-2])[A-Da-d]$|^13[A-Fa-f]$" }
              ]
            },
            "in": "path"
          }
        ]
      }
    },
    "/control/osd/{side}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Position or hide the HDMI information menu",
        "description": "Show reception and service information on the selected side of the fullscreen HDMI output.",
        "parameters": [{ "name": "side", "in": "path", "required": true, "description": "Menu position",
          "example": "left", "schema": { "type": "string", "enum": ["left", "right", "off"] } }],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "description": "Enable HDMI first." }
        }
      }
    },
    "/control/hdmi/{monitor}": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Select the fullscreen HDMI display",
        "description": "Use the embedded DVB player. The monitor selection is restored at GUI startup. Read hdmi_monitor and hdmi_state from /status.",
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "description": "Display number starting at 1, or off to close fullscreen output.",
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "description": "Select the embedded player."
          },
          "500": {
            "description": "Could not save display selection."
          }
        }
      }
    },
    "/control/program/{id}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Watch a DVB program",
        "description": "Read programs from GET /status, then supply the decimal service ID of the program to watch. Requires active DVB reception with the embedded player. selected_program reports the playback selection. The selected service is also used for Teletext and program information when switching.",
        "parameters": [
          {
            "name": "id", "in": "path", "required": true,
            "description": "DVB service ID from the current stream's program list.",
            "example": 101,
            "schema": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "description": "Program unavailable, embedded playback inactive or switch failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/control/eit/{action}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Switch the current and next programme overlay on HDMI",
        "description": "Uses the desktop EIT button state. Opening the programme window also shows its overlay on active HDMI output. Closing the window hides both. GET /status reports eit_overlay_enabled.",
        "parameters": [{ "name": "action", "in": "path", "required": true, "description": "Choose the overlay state.", "example": "on", "schema": { "type": "string", "enum": ["on", "off", "toggle"] } }],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "$ref": "#/components/responses/409" }
        }
      }
    },
    "/control/teletext/on": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Show Teletext",
        "description": "During DVB reception, show the current page on the active HDMI display or in the desktop Teletext window. GET /status reports whether the window is visible in teletext_visible.",
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "$ref": "#/components/responses/409" }
        }
      }
    },
    "/control/teletext/off": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Hide Teletext",
        "description": "Hide HDMI Teletext and close the desktop Teletext window. The selected page is retained during reception. This also works when the window is already closed or reception has stopped.",
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "$ref": "#/components/responses/409" }
        }
      }
    },
    "/control/teletext/color/{color}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Follow a Teletext color link",
        "description": "Press a Fastext color key during DVB reception to open the destination for the current page. When the broadcaster supplies no color links, the receiver can use up to four page numbers printed in index rows. Read teletext_color_links from GET /status to see the available colors and their destination page numbers.",
        "parameters": [
          {
            "name": "color", "in": "path", "required": true,
            "description": "Color key on the remote control.",
            "example": "red",
            "schema": { "type": "string", "enum": ["red", "green", "yellow", "blue"] }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "description": "DVB reception is unavailable or the current page has no link for that color.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/control/teletext/{page}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Open a Teletext page",
        "description": "During DVB reception, show Teletext on the active HDMI display or in the desktop window and select a page of the current service. A cached page appears immediately. Otherwise the receiver waits for the broadcast. The HTTP response acknowledges selection. Read teletext_page and teletext_page_received from GET /status to check availability.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "description": "Three-digit decimal Teletext page number.",
            "example": 101,
            "schema": { "type": "integer", "minimum": 100, "maximum": 899 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "$ref": "#/components/responses/409" }
        }
      }
    },
    "/control/preset/{slot}": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Recall a preset",
        "description": "Load a saved preset. If the SDR is running, it stops before loading the preset. Send PUT /control/start to resume reception.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "202": {
            "$ref": "#/components/responses/202"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "name": "slot",
            "description": "Saved preset slot. GET /status lists the label and saved flag for each slot.",
            "required": true,
            "example": 2,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "in": "path"
          }
        ]
      }
    },
    "/control/mode/{mode}": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Select the mode",
        "description": "Stop the SDR before changing the receiver mode. DAB selects a bandwidth of 1536000 Hz and DVB-T2 selects 8000000 Hz. Both use automatic FEC. Knucker supports DVB-T only.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "name": "mode",
            "description": "Receiver mode for the selected input. DVB-T, DVB-T2, DVB-S, DVB-S2 and DAB are case-insensitive.",
            "required": true,
            "example": "dvb-t",
            "schema": {
              "type": "string",
              "pattern": "^([Dd][Vv][Bb]-[TtSs]2?|[Dd][Aa][Bb])$"
            },
            "in": "path"
          }
        ]
      }
    },
    "/control/rate/{rate}": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Set bandwidth or symbol rate",
        "description": "Stop the SDR first. Use bandwidth in Hz for DVB-T and symbol rate in symbols per second for DVB-S and DVB-S2.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "name": "rate",
            "description": "A rate supported by the selected mode and input.",
            "required": true,
            "example": 250000,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            },
            "in": "path"
          }
        ]
      }
    },
    "/control/gpu-ldpc/{state}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Turn GPU LDPC decoding on or off",
        "description": "Stop reception first. The setting applies to the selected mode at the next start. DVB-T2 can try the GPU with CPU fallback. DVB-S2 requires the embedded soft-decision decoder on Linux and tries the GPU for 8PSK 3/4 normal frames. GET /status reports the preference in configured_gpu_ldpc. The receiver log shows actual decoder activity.",
        "parameters": [
          {
            "name": "state",
            "in": "path",
            "required": true,
            "description": "Use on to request GPU decoding or off to disable it. Values are case-insensitive.",
            "example": "on",
            "schema": { "type": "string", "pattern": "^[Oo]([Nn]|[Ff][Ff])$" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "$ref": "#/components/responses/409" }
        }
      }
    },
    "/control/constellation/{constellation}": {
      "put": {
        "tags": ["Receiver control"],
        "summary": "Select the DVB-S2 constellation",
        "description": "Stop the SDR and select DVB-S2 first. Choose QPSK or 8PSK (case-insensitive). Switching to 8PSK keeps a compatible FEC or selects 2/3 if the current rate is incompatible. GET /status reports configured_constellation and configured_fec.",
        "parameters": [
          {
            "name": "constellation",
            "in": "path",
            "required": true,
            "description": "DVB-S2 constellation, QPSK or 8PSK.",
            "example": "8psk",
            "schema": { "type": "string", "pattern": "^([Qq]|8)[Pp][Ss][Kk]$" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/200" },
          "400": { "$ref": "#/components/responses/400" },
          "403": { "$ref": "#/components/responses/403" },
          "409": { "$ref": "#/components/responses/409" }
        }
      }
    },
    "/control/fec/{numerator}/{denominator}": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Select a FEC code rate",
        "description": "Stop the SDR and select a code rate supported by the current mode and constellation. Supply the numerator and denominator as separate path segments.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "name": "numerator",
            "description": "Numerator of the code rate.",
            "required": true,
            "example": 1,
            "schema": {
              "type": "integer"
            },
            "in": "path"
          },
          {
            "name": "denominator",
            "description": "Denominator of the code rate.",
            "required": true,
            "example": 2,
            "schema": {
              "type": "integer"
            },
            "in": "path"
          }
        ]
      }
    },
    "/control/fec/auto": {
      "put": {
        "tags": [
          "Receiver control"
        ],
        "summary": "Select automatic FEC",
        "description": "Stop the SDR first. Use this setting for modes or inputs with automatic FEC, such as DVB-T2 or Knucker.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "stopped",
              "running",
              "stopping",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "control_enabled": {
            "type": "boolean"
          },
          "standard": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "configured_frequency_hz": {
            "type": "number",
            "nullable": true
          },
          "programs": {
            "type": "array", "description": "DVB services discovered in the current stream.",
            "items": { "type": "object", "properties": {
              "id": { "type": "integer" }, "name": { "type": "string" }, "provider": { "type": "string" }
            } }
          },
          "selected_program": { "type": "integer", "nullable": true, "description": "Service ID selected for playback, or null when none is selected in the current list." },
          "hdmi_monitor": { "type": "integer", "description": "Display number starting at 1, or zero when off." },
          "hdmi_osd": { "type": "string", "enum": ["left", "right", "off"] },
          "eit_overlay_enabled": { "type": "boolean" },
          "hdmi_teletext_visible": { "type": "boolean" },
          "hdmi_state": { "type": "string", "enum": ["Off", "No Signal", "Init", "Locked", "Video"] },
          "teletext_visible": { "type": "boolean", "description": "Whether Teletext is visible on HDMI or in the desktop window." },
          "teletext_page": { "type": "integer", "description": "Selected page in the active desktop DVB Teletext viewer." },
          "teletext_index_shortcuts": { "type": "boolean", "description": "The color keys use printed index entries as local shortcuts." },
          "teletext_color_links": { "type": "object", "description": "Available Fastext keys and their destination page numbers on the current page.", "additionalProperties": { "type": "integer", "minimum": 100, "maximum": 899 } },
          "teletext_page_received": { "type": "boolean", "description": "True when the selected page is available to display." },
          "configured_gpu_ldpc": {
            "type": "boolean",
            "description": "GPU LDPC preference for the selected mode, present in DVB-S2 and DVB-T2."
          },
          "configured_constellation": {
            "type": "string",
            "enum": ["QPSK", "8PSK"],
            "description": "Selected constellation, present in DVB-S2 mode."
          },
          "configured_fec": {
            "type": "string"
          },
          "active_preset": {
            "type": "number"
          },
          "presets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "saved": {
                  "type": "boolean"
                }
              }
            }
          },
          "telemetry_fresh": {
            "type": "boolean"
          },
          "recent_log": {
            "type": "string"
          }
        }
      },
      "Constellation": {
        "type": "object",
        "properties": {
          "standard": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          },
          "fresh": {
            "type": "boolean"
          },
          "received_unix_ms": {
            "type": "number",
            "nullable": true
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "accepted"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "responses": {
      "200": {
        "description": "Command completed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Accepted"
            }
          }
        }
      },
      "202": {
        "description": "Command accepted. Poll GET /status until state is stopped.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Accepted"
            }
          }
        }
      },
      "400": {
        "description": "Invalid value or nonempty request body.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Remote control is disabled or the receiver is running in headless mode.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "The preset slot is empty.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "The current receiver state, input or configuration prevents this command.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
