# Publish only linrad_dvb and its documentation/development files.
# New top-level files/directories must be deliberately added to this list.
/*
!/.gitignore
!/LICENSE
!/NOTICE
!/README.md
!/Makefile
!/VERSION
!/linrad-dvb.example.ini
!/linrad-dvbt2-eindhoven.example.ini
!/direwolf-pcm.conf
!/src/
!/components/
!/benchmarks/
!/third_party/
!/tests/
!/tools/
!/dev/
!/docs/

# Generated files inside the included directories also stay local.
__pycache__/
.pytest_cache/
target/
*.py[cod]
*.o
*.a
*.so
*.d
*.log
*.iq
*.iq.json
*.ts
*.zip

# Only the selected documentation screenshot is published.
*.png
*.jpg
*.jpeg
!/docs/images/linrad-dvb-dvbt2.png
