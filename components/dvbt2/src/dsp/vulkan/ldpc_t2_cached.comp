#version 450
#extension GL_EXT_control_flow_attributes : require
layout(constant_id = 0) const int DEGREE = 64;
layout(constant_id = 1) const int CACHE_GROUPS = 32;
// DVB-T2 layered normalized min-sum; one 360-thread workgroup per codeword.
// Same FP32 posterior update order as ldpc_t2.comp. Store each check's two
// scaled minima and packed signs/index instead of one float per edge. Cache
// a bounded prefix of posteriors in shared memory; specialize private arrays
// to the code's maximum degree. Generated by tools/gen_cached_spirv.py.
layout(local_size_x = 360, local_size_y = 1, local_size_z = 1) in;

const int Z = 360;

layout(push_constant) uniform P { int k, n, q, G, maxIter; float alpha; uint msgPer, postPer; } p;

layout(std430, binding = 0) readonly buffer B0 { int lStart[]; };
layout(std430, binding = 1) readonly buffer B1 { int cGrp[]; };
layout(std430, binding = 2) readonly buffer B2 { int cSh[]; };
layout(std430, binding = 3) readonly buffer B3 { uint mBase[]; };
layout(std430, binding = 4) readonly buffer B4 { int cRank[]; };
layout(std430, binding = 5) readonly buffer B5 { int layerR[]; };
layout(std430, binding = 6) coherent buffer B6 { float post[]; };
layout(std430, binding = 7) buffer B7 { uint msg[]; };
layout(std430, binding = 8) readonly buffer B8 { float llr[]; };
layout(std430, binding = 9) writeonly buffer B9 { uint hard[]; };
layout(std430, binding = 10) writeonly buffer B10 { int info[]; };

shared int bad;
shared float hot[CACHE_GROUPS*360];
float loadPost(uint base, uint index) { return index<uint(CACHE_GROUPS*360) ? hot[index] : post[base+index]; }
void storePost(uint base, uint index, float value) { if (index<uint(CACHE_GROUPS*360)) hot[index]=value; else post[base+index]=value; }

float oldMessage(int j, float a, float b, uint flags, uint lo, uint hi) {
    uint smallest=DEGREE<=26 ? (flags>>26u)&31u : flags&63u;
    uint signs=j<32 ? lo : hi;
    uint negative=(flags>>31u)^((signs>>(uint(j)&31u))&1u);
    return uintBitsToFloat(floatBitsToUint(smallest==uint(j) ? b : a)|(negative<<31u));
}

int vidx(int j, int nc0, int c0, int r, int m) {
    if (j < nc0) { int nn = m - cSh[c0 + j]; if (nn < 0) nn += Z; return cGrp[c0 + j] * Z + nn; }
    const int pb = p.G * Z;
    if (j == nc0) return pb + r * (Z + 1) + 1 + m;
    return pb + (r > 0 ? (r - 1) * (Z + 1) + 1 + m : (p.q - 1) * (Z + 1) + m);
}

void syncPost() { memoryBarrierBuffer(); memoryBarrierShared(); barrier(); }
void syncShared() { memoryBarrierShared(); barrier(); }

void main() {
    const int m = int(gl_LocalInvocationID.x);
    const uint blk = gl_WorkGroupID.x;
    const uint pB = blk * p.postPer, mB = blk * p.msgPer, lB = blk * uint(p.n);
    const int q = p.q, G = p.G, pb = G * Z;
    for (int i = m; i < G * Z; i += Z) storePost(pB,uint(i),llr[lB+uint(i)]);
    for (int r = 0; r < q; r++) {
        storePost(pB,uint(pb+r*(Z+1)+1+m),llr[lB+uint(p.k+r+q*m)]);
        if (m == 0) storePost(pB,uint(pb+r*(Z+1)),1e4);
    }
    for (uint i = uint(m); i < p.msgPer; i += uint(Z)) msg[mB + i] = 0u;
    syncPost();
    int it = 0;
    bool ok = false;
    while (it < p.maxIter) {
        for (int r = 0; r < q; r++) {
            const int c0 = lStart[r], nc0 = lStart[r + 1] - c0, nc = nc0 + 2;
            const uint checks=uint(q*Z), mr=mB+uint(r*Z+m);
            const float oldMin1=uintBitsToFloat(msg[mr]), oldMin2=uintBitsToFloat(msg[mr+checks]);
            const uint oldFlags=msg[mr+uint(DEGREE<=26 ? 2 : 4)*checks];
            const uint oldLo=DEGREE<=26 ? oldFlags : msg[mr+2u*checks];
            const uint oldHi=DEGREE<=26 ? 0u : msg[mr+3u*checks];
            float min1 = 1e30, min2 = 1e30;
            int idx1 = -1;
            uint sg = 0u;
            uint lo=0u, hi=0u;
            float dl[DEGREE];
            [[unroll]] for (int j = 0; j < DEGREE; j++) {
                if (j >= nc) continue;
                precise float x = loadPost(pB,uint(vidx(j,nc0,c0,r,m))) - oldMessage(j,oldMin1,oldMin2,oldFlags,oldLo,oldHi);
                dl[j] = x;
                float a = abs(x);
                sg ^= floatBitsToUint(x) & 0x80000000u;
                if ((floatBitsToUint(x)&0x80000000u)!=0u) {
                    if (j<32) lo |= 1u<<uint(j); else hi |= 1u<<uint(j-32);
                }
                if (a < min1) { min2 = min1; min1 = a; idx1 = j; }
                else if (a < min2) min2 = a;
            }
            // A layer may reach the same variable group twice (a variable then has two edges in the layer, owned by different
            // invocations). Every new message is computed from the posteriors as they were at the start of the layer, and the
            // posterior increments are applied afterwards: unique edges at once, repeated ones one rank at a time.
            const int R = layerR[r];
            [[unroll]] for (int j = 0; j < DEGREE; j++) {
                if (j >= nc) continue;
                const uint vi = uint(vidx(j, nc0, c0, r, m));
                precise float x = dl[j];
                precise float mag = (idx1 == j ? min2 : min1) * p.alpha;
                float nm = uintBitsToFloat(floatBitsToUint(mag) | (sg ^ (floatBitsToUint(x) & 0x80000000u)));
                precise float d = nm - oldMessage(j,oldMin1,oldMin2,oldFlags,oldLo,oldHi);
                if (R == 0) { if (!(r == 0 && j == nc0 + 1 && m == 0)) { precise float s = loadPost(pB,vi) + d; storePost(pB,vi,s); } }   // the pad variable stays known
                else dl[j] = d;
            }
            if (R > 0) {
                syncPost();
                for (int rk = 0; rk <= R; rk++) {
                    [[unroll]] for (int j = 0; j < DEGREE; j++) {
                        if (j >= nc) continue;
                        const int rank = j < nc0 ? cRank[c0 + j] : 0;
                        if (rank != rk) continue;
                        if (r == 0 && j == nc0 + 1 && m == 0) continue;
                        const uint vi = uint(vidx(j, nc0, c0, r, m));
                        precise float s = loadPost(pB,vi) + dl[j];
                        storePost(pB,vi,s);
                    }
                    syncPost();
                }
            }
            precise float nextMin1=min1*p.alpha, nextMin2=min2*p.alpha;
            msg[mr]=floatBitsToUint(nextMin1); msg[mr+checks]=floatBitsToUint(nextMin2);
            if (DEGREE<=26) msg[mr+2u*checks]=lo|(uint(idx1)<<26u)|sg;
            else {
                msg[mr+2u*checks]=lo;
                msg[mr+3u*checks]=hi;
                msg[mr+4u*checks]=uint(idx1)|sg;
            }
            syncPost();
        }
        it++;
        if (m == 0) bad = 0;
        syncShared();
        for (int r = 0; r < q; r++) {
            const int c0 = lStart[r], nc0 = lStart[r + 1] - c0, nc = nc0 + 2;
            int par = 0;
            for (int j = 0; j < nc; j++) par ^= loadPost(pB,uint(vidx(j,nc0,c0,r,m))) < 0.0 ? 1 : 0;
            if (par != 0) { atomicOr(bad, 1); break; }
        }
        syncShared();
        ok = bad == 0;
        syncShared();   // everyone has read `bad` before the next round may reset it
        if (ok) break;
    }
    const uint hB = blk * uint(p.n);
    for (int i = m; i < G * Z; i += Z) hard[hB + uint(i)] = loadPost(pB,uint(i)) < 0.0 ? 1u : 0u;
    for (int r = 0; r < q; r++) hard[hB + uint(p.k + r + q * m)] = loadPost(pB,uint(pb+r*(Z+1)+1+m)) < 0.0 ? 1u : 0u;
    if (m == 0) { info[blk * 2u] = ok ? 1 : 0; info[blk * 2u + 1u] = it; }
}
